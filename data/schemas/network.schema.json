{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/govtechnl/onegov3-inferentie-netwerk/data/schemas/network.schema.json",
  "title": "Fictitious federated inference network",
  "type": "object",
  "required": ["version", "organisations", "models", "sites", "transfer_overhead_s"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string"},
    "organisations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "gateway_port"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string"},
          "role": {"enum": ["ministerie", "uitvoeringsorganisatie", "provincie", "gemeente"]},
          "gateway_port": {"type": "integer", "minimum": 1024, "maximum": 65535}
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "model_class", "gpu_s_per_1k_in", "gpu_s_per_1k_out"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "model_class": {"type": "string"},
          "gpu_s_per_1k_in": {"type": "number", "minimum": 0},
          "gpu_s_per_1k_out": {"type": "number", "minimum": 0}
        }
      }
    },
    "transfer_overhead_s": {
      "type": "object",
      "required": ["federatie", "onderzoek", "commercieel"],
      "additionalProperties": false,
      "properties": {
        "federatie": {"type": "number", "minimum": 0},
        "onderzoek": {"type": "number", "minimum": 0},
        "commercieel": {"type": "number", "minimum": 0}
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "owner", "gpus", "speed_factor", "models", "tariff_eur_per_gpu_hour",
                     "kwh_per_gpu_hour", "accepts_from_others", "max_external_share", "properties", "availability"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string"},
          "kind": {"enum": ["overheid", "onderzoek", "commercieel"]},
          "owner": {"type": ["string", "null"]},
          "gpus": {"type": "integer", "minimum": 0},
          "speed_factor": {"type": "number", "exclusiveMinimum": 0},
          "models": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "tariff_eur_per_gpu_hour": {"type": "number", "minimum": 0},
          "kwh_per_gpu_hour": {"type": "number", "minimum": 0},
          "accepts_from_others": {
            "type": "object",
            "required": ["data_classes", "tiers"],
            "additionalProperties": false,
            "properties": {
              "data_classes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "tiers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          },
          "max_external_share": {"type": "number", "minimum": 0, "maximum": 1},
          "properties": {
            "type": "array",
            "items": {"enum": ["eu_jurisdiction", "zdr", "no_training"]},
            "uniqueItems": true
          },
          "availability": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end", "share"],
              "additionalProperties": false,
              "properties": {
                "start": {"type": "integer", "minimum": 0, "maximum": 23},
                "end": {"type": "integer", "minimum": 1, "maximum": 24},
                "share": {"type": "number", "minimum": 0, "maximum": 1},
                "reason": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
