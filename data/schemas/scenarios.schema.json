{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/govtechnl/onegov3-inferentie-netwerk/data/schemas/scenarios.schema.json",
  "title": "Demo scenarios",
  "type": "object",
  "required": ["version", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "demand", "overlays"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "demand": {"type": "string"},
          "overlays": {"type": "array", "items": {"$ref": "#/$defs/overlay"}}
        }
      }
    }
  },
  "$defs": {
    "overlay": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "org", "start", "end", "factor"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "demand_multiplier"},
            "org": {"type": "string"},
            "tier": {"type": "string"},
            "start": {"type": "integer", "minimum": 0, "maximum": 23},
            "end": {"type": "integer", "minimum": 1, "maximum": 24},
            "factor": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "required": ["type", "id", "org", "tier", "data_class", "task", "start", "end", "requests_per_slot",
                       "tokens_in_per_request", "tokens_out_per_request"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "extra_workload"},
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            "org": {"type": "string"},
            "tier": {"type": "string"},
            "data_class": {"type": "string"},
            "task": {"type": "string"},
            "start": {"type": "integer", "minimum": 0, "maximum": 23},
            "end": {"type": "integer", "minimum": 1, "maximum": 24},
            "requests_per_slot": {"type": "integer", "minimum": 1},
            "tokens_in_per_request": {"type": "integer", "minimum": 0},
            "tokens_out_per_request": {"type": "integer", "minimum": 0},
            "description": {"type": "string"}
          }
        },
        {
          "type": "object",
          "required": ["type", "site", "start", "end", "share"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "availability"},
            "site": {"type": "string"},
            "start": {"type": "integer", "minimum": 0, "maximum": 23},
            "end": {"type": "integer", "minimum": 1, "maximum": 24},
            "share": {"type": "number", "minimum": 0, "maximum": 1},
            "reason": {"type": "string"}
          }
        }
      ]
    }
  }
}
