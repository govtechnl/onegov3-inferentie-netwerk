{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/govtechnl/onegov3-inferentie-netwerk/data/schemas/policy.schema.json",
  "title": "Routing, priority and coordination rules",
  "type": "object",
  "required": ["version", "slot_seconds", "data_classes", "tiers", "task_models", "coordination", "settlement"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string"},
    "slot_seconds": {"type": "integer", "minimum": 60},
    "data_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "allowed_relations", "commercial_requires"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "allowed_relations": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["eigen", "federatie", "onderzoek", "commercieel"]},
            "uniqueItems": true
          },
          "commercial_requires": {
            "type": "array",
            "items": {"enum": ["eu_jurisdiction", "zdr", "no_training"]},
            "uniqueItems": true
          }
        }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "priority", "objective", "max_delay_s", "price_multiplier",
                     "receiving_reserve_share"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "priority": {"type": "integer", "minimum": 1},
          "objective": {"enum": ["time", "cost"]},
          "max_delay_s": {"type": "number", "minimum": 0},
          "price_multiplier": {"type": "number", "minimum": 0},
          "receiving_reserve_share": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "task_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task", "model_class"],
        "additionalProperties": false,
        "properties": {
          "task": {"type": "string"},
          "model_class": {"type": "string"},
          "max_tokens_in_per_request": {"type": "integer", "minimum": 1}
        }
      }
    },
    "coordination": {
      "type": "object",
      "required": ["mode", "prefer_local", "min_gain", "receiving_protection", "switching_toll",
                   "defer_when_no_capacity"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["naive", "coordinated"]},
        "prefer_local": {"type": "boolean"},
        "min_gain": {
          "type": "object",
          "required": ["seconds", "ratio"],
          "additionalProperties": false,
          "properties": {
            "seconds": {"type": "number", "minimum": 0},
            "ratio": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "receiving_protection": {
          "type": "object",
          "required": ["max_utilisation"],
          "additionalProperties": false,
          "properties": {"max_utilisation": {"type": "number", "exclusiveMinimum": 0}}
        },
        "switching_toll": {
          "type": "object",
          "required": ["fixed_s", "runtime_fraction"],
          "additionalProperties": false,
          "properties": {
            "fixed_s": {"type": "number", "minimum": 0},
            "runtime_fraction": {"type": "number", "minimum": 0}
          }
        },
        "defer_when_no_capacity": {"type": "boolean"}
      }
    },
    "settlement": {
      "type": "object",
      "required": ["pricing", "currency"],
      "additionalProperties": false,
      "properties": {
        "pricing": {"enum": ["fixed_tariff"]},
        "currency": {"type": "string"}
      }
    }
  }
}
